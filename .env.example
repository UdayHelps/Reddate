# Copy to .env (git-ignored) for local development. On Render, set these in the dashboard.

# GIF picker — free key from https://developers.giphy.com/ (Create an App → API)
GIPHY_API_KEY=
# Our own catalog (movies & series from TMDB). A free "API Read Access Token" from
# https://www.themoviedb.org/settings/api — without it the app uses the Cinemeta catalog.
TMDB_TOKEN=
# Optional: shows a "Buy me a coffee" link (e.g. https://buymeacoffee.com/yourname)
SUPPORT_URL=

# Private stats page at /stats (anonymous counts). Free Redis database from
# https://upstash.com → Create Database → REST API section. STATS_PASSWORD is
# what you type to open /stats (any username).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
STATS_PASSWORD=

# Optional accounts (sign in, profiles, saved addons, TVs). Needs the Upstash settings above
# plus a mail provider (https://resend.com). For local development use MAIL_MODE=log instead
# (mail is printed to the console, accounts live in memory, and a throwaway secret is used).
# VAULT_SECRET=a-long-random-string   (encrypts saved accounts at rest — keep a copy!)
# RESEND_API_KEY=
# MAIL_FROM=Reddate <hello@reddate.xyz>
# PUBLIC_URL=https://reddate.xyz
# MAIL_MODE=log

# Optional TURN relay for video calls behind strict NATs
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Optional, for the full Reddate TV setup ---
# Where the TV app download redirects (default: the latest GitHub Release of this repository)
# APK_URL=https://github.com/<owner>/Reddate/releases/latest/download/reddate-tv.apk
# Open connections and new connections/joins a minute allowed from one network address (default 100, 0 = off)
# MAX_SOCKETS_PER_IP=100
# Extra web hosts that serve the browser app (comma separated)
# WEB_HOSTS=
# Where bug reports are emailed (needs RESEND_API_KEY and MAIL_FROM)
# REPORT_TO=you@example.com
# Trakt and Simkl watch tracking (create an app on each site)
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=
# SIMKL_CLIENT_ID=
# SIMKL_CLIENT_SECRET=
# Cloudflare Turnstile on sign-up
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Keep this site's stats separate when another site shares the same Redis (default: stats)
STATS_PREFIX=
